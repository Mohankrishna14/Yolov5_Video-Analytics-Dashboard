# GPU Dockerfile (example, adapt CUDA version as needed)
# Requires NVIDIA Container Toolkit / nvidia-docker2 to run.
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

WORKDIR /app
COPY requirements.txt .

# Install python
RUN apt-get update && apt-get install -y python3 python3-pip python3-venv libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*

# NOTE: For GPU you must install a torch wheel matching the CUDA version.
# Example: pip install --index-url https://download.pytorch.org/whl/cu121 torch torchvision --upgrade
RUN pip3 install --no-cache-dir -r requirements.txt

COPY . /app

EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
